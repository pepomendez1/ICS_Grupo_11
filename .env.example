# Copialo a .env y descomentá (sacá el #) solo lo que quieras usar.
# Lo que quede comentado usa la versión local/simulada.

# Connection string de Supabase: Project Settings > Database > Connection string
# Usá el "Transaction pooler" (puerto 6543): la conexión directa es solo IPv6 y Vercel no la alcanza.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Cualquier texto largo y aleatorio. Tiene que ser fijo en Vercel.
SECRET_KEY=cambiame-por-algo-largo-y-aleatorio

# ---------- Mercado Pago (opcional: sin token se usa el checkout simulado) ----------
# Access Token del vendedor de prueba (ver README > Mercado Pago).
# MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
# URL pública de la app, sin "/" al final. En local, la de ngrok.
# APP_BASE_URL=https://ecoharmony-park.vercel.app
